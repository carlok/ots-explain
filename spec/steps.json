  ],
  "exit_codes": {
    "0": "verdict PASS",
    "1": "verdict FAIL",
    "2": "usage or input error",
    "3": "verdict SKIP (something was not checked)"
  },
  "steps": [
    {
      "id": "file_hash",
      "title": "File to hash",
      "why": "The proof is about one exact sequence of bytes; check first that your file (or digest) is the one the proof names."
    },
    {
      "id": "structure",
      "title": "Proof structure",
      "why": "An .ots file is a small tree of operations ending in attestations; reading it yourself shows what it claims and where it points."
    },
    {
      "id": "hash_steps",
      "title": "Hash steps",
      "why": "Every hop from your digest to the attestation is recomputed here, so nothing is taken on trust from the proof or a server."
    },
    {
      "id": "ledger",
      "title": "The ledger",
      "why": "Only the Bitcoin blockchain can tell that the final digest is really in a block; this asks explorers, and only when you ask."
    },
    {
      "id": "verdict",
      "title": "Verdict",
      "why": "The answer to one question: did this file exist before that block? Green only if every check passed and none was skipped."
    }
  ],
  "phases": [
    {
      "id": "calendar_tree",
      "title": "The calendar's tree"
    },
    {
      "id": "transaction",
      "title": "The transaction"
    },
    {
      "id": "block_merkle_path",
      "title": "The block's merkle path"
    }
  ],
  "ledger_checks": [
    {
      "id": "block_hash",
      "title": "Block hash at that height"
    },
    {
      "id": "header",
      "title": "Block header and proof of work"
    },
    {
      "id": "merkle_root",
      "title": "Merkle root equals the proof's final digest"
    },
    {
      "id": "txids",
      "title": "The transaction is in the block"
    },
    {
      "id": "raw_tx",
      "title": "The transaction (witness removed) matches the proof"
    },
    {
      "id": "output",
      "title": "An output carries the digest"
    }
  ],
